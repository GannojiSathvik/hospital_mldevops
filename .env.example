# =============================================================================
# Copy to .env and change EVERY value:   cp .env.example .env
# .env is git-ignored. The keys below are OBVIOUSLY FAKE demo values for local
# development only — they are allow-listed in .gitleaks.toml by exact value.
# Generate real keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# Runtime environment: development | ci | staging | production
ENV=development

# API keys — format name:role:key, comma-separated.
# Roles (configs/access_control.yaml): viewer, clinician, analyst, ml_engineer, admin
API_KEYS=demo-viewer:viewer:demo-viewer-key-change-me,demo-clinician:clinician:demo-clinician-key-change-me,demo-analyst:analyst:demo-analyst-key-change-me,demo-ml-engineer:ml_engineer:demo-ml-engineer-key-change-me,demo-admin:admin:demo-admin-key-change-me

# Key used by CLI pipelines (training/retraining/validation) — Lab 6 RBAC.
# Must belong to a role with pipeline:* permissions (ml_engineer or admin).
PIPELINE_API_KEY=demo-ml-engineer-key-change-me
ENFORCE_PIPELINE_RBAC=true

# Experiment tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# API hardening
MAX_UPLOAD_MB=5
RATE_LIMIT=60/minute

# Grafana (docker-compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=demo-grafana-password-change-me
